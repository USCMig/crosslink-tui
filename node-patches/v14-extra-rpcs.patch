+    /// BFT height this node is currently trying to decide (the height *not yet* decided).
+    pub bft_height: u64,
+    /// Round within `bft_height`. A round above 0 means earlier rounds failed to decide.
+    pub bft_round: u32,
+    /// `"propose"`, `"prevote"` or `"precommit"`.
